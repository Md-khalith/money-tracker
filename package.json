{
  "name": "money-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Simple, self-hosted personal finance tracking web application",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build": "echo 'Backend ready for deployment'",
    "build:client": "npm --prefix client run build",
    "start": "node server/server.js",
    "start:mcp": "node mcp/httpServer.js",
    "install:all": "npm install && npm --prefix client install",
    "db:reset": "node server/db/reset.js",
    "db:test": "node server/db/test-connection.js",
    "mcp": "node mcp/server.js",
    "mcp:remote": "node mcp/httpServer.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
