# ==============================================================================
# Money Tracker - Backend Environment Variables
# NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# Database: Neon PostgreSQL Connection String (REQUIRED for backend)
# Found in Neon Console -> Dashboard -> Connection Details -> Pooled connection string
# Format: postgresql://USER:PASSWORD@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Server Runtime Configuration
# Render automatically injects PORT at runtime (usually 10000).
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS)
# Set to your deployed frontend domain (e.g., GitHub Pages)
# Multiple origins can be comma-separated.
FRONTEND_URL=https://md-khalith.github.io

# ==============================================================================
# Remote MCP Server Environment Variables (Render Web Service)
# ==============================================================================
# Base URL of the deployed Express backend (Render URL)
# For local dev: http://localhost:5000
# For production: https://money-tracker-api-efqa.onrender.com
API_BASE_URL=https://money-tracker-api-efqa.onrender.com

# Optional Authentication key for MCP endpoint (if enabled)
# If left empty, MCP server endpoints remain public
MCP_API_KEY=
