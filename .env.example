# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration
# In cloud platforms with persistent volume (e.g. Render / Fly.io / Railway), point to volume path
DATABASE_PATH=./data/money-tracker.db

# Cross-Origin Resource Sharing (CORS)
# Set to your deployed frontend domain when hosted separately (e.g. https://money-tracker.vercel.app)
# Supports comma-separated list of origins. If unset, defaults to '*'
FRONTEND_URL=

# Remote MCP Server Configuration (when deploying MCP separately)
MCP_PORT=8080
# Optional secret key to authenticate remote MCP connections (Bearer token / X-API-Key)
MCP_API_KEY=
