# PostgreSQL / Neon Connection String
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS)
